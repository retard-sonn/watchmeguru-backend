# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Groq AI
GROQ_API_KEY=your_groq_api_key

# WhatsApp Meta API (Legacy)
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
